+'use client';
+
+import { PageHeader } from '@app/components/PageHeader';
+import { changePassword, useCurrentUser } from '@app/entities/auth';
+import { Button } from '@packages/ui/Button';
+import { Controller, Form } from '@packages/ui/Form';
+import { PasswordInput } from '@packages/ui/Input';
+import { toast } from '@packages/ui/Toast';
+import {
+  DescriptionDetails,
+  DescriptionList,
+  DescriptionTerm,
+  Paragraph,
+} from '@packages/ui/Typography';
+import { Pencil } from 'lucide-react';
+import React, { useState } from 'react';
+import { useForm } from 'react-hook-form';
+
+type PasswordValues = { password: string };
+
+/** The owner's own sign-in details, with the password changed in place. */
+export default function AccountPage() {
+  const user = useCurrentUser();
+  const [editing, setEditing] = useState(false);
+  const {
+    control,
+    handleSubmit,
+    setError,
+    reset,
+    formState: { errors, isSubmitting },
+  } = useForm<PasswordValues>({ defaultValues: { password: '' } });
+
+  const save = async ({ password }: PasswordValues) => {
+    if (password.length < 8) {
+      reset({ password: '' });
+      setError('password', {
+        message: 'Enter a password of at least 8 characters.',
+      });
+      return;
+    }
+    try {
+      await changePassword(password);
+      toast({ title: 'Password saved', status: 'success' });
+      setEditing(false);
+      reset({ password: '' });
+    } catch {
+      setError('root', {
+        message: 'Saving failed. The account is unchanged. Try again.',
+      });
+    }
+  };
+
+  return (
+    <>
+      <PageHeader
+        title="Account"
+        description="Your own sign-in details."
+        actions={
+          editing ? undefined : (
+            <Button
+              // Editing is the page's only action.
+              variant="base"
+              leftIcon={<Pencil />}
+              onClick={() => setEditing(true)}
+            >
+              Edit
+            </Button>
+          )
+        }
+      />
+      <DescriptionList>
+        <div>
+          <DescriptionTerm>Email</DescriptionTerm>
+          <DescriptionDetails>{user?.email ?? ''}</DescriptionDetails>
+        </div>
+      </DescriptionList>
+      {editing ? (
+        <Form
+          onSubmit={handleSubmit(save)}
+          error={errors.root?.message}
+          actions={
+            <Button
+              type="submit"
+              loadingWithReason={isSubmitting ? 'Saving the password' : undefined}
+            >
+              Done
+            </Button>
+          }
+        >
+          <Controller
+            name="password"
+            control={control}
+            rules={{ required: 'Enter a new password of at least 8 characters' }}
+          >
+            {({ field }) => (
+              <PasswordInput
+                label="New password"
+                autoComplete="new-password"
+                helpText="Use 8 or more characters"
+                {...field}
+              />
+            )}
+          </Controller>
+        </Form>
+      ) : (
+        <Paragraph color="muted">
+          Choose Edit to set a new password.
+        </Paragraph>
+      )}
+    </>
+  );
+}
diff --git a/web/app/(routes)/(app)/dashboard/discount-codes/[discountCodeId]/page.tsx b/web/app/(routes)/(app)/dashboard/discount-codes/[discountCodeId]/page.tsx
