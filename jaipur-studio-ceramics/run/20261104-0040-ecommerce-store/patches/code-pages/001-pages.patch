+          // Retry is the quiet way back after a failed load.
+          variant="base"
+          onClick={piece.retry}
+        >
+          Try again
+        </Button>
+      </div>
+    );
+  }
+
+  const record = piece.data;
+  if (!record) {
+    return (
+      <NotFound
