 import { useOrderStore } from './store';
 
@@ -65,3 +66,138 @@ export async function cancelOrder(id: string, changes: Partial<OrderInput>): Pro
   useOrderStore.setState(({ records }) => ({ records: records.map((r) => (r.id === id ? record : r)) }));
