+            <AttentionTable.Column
+              id="state"
+              title="State"
+              dataKey="stock"
+              width={130}
+            >
+              {(stock) =>
+                stock <= 0 ? (
+                  <Tag
+                    // Sold out decides the next batch, so it reads as an error.
+                    variant="error"
+                  >
+                    Sold out
+                  </Tag>
+                ) : (
+                  <Tag
+                    // Three or fewer left is the owner's restock signal.
+                    variant="warning"
+                  >
+                    Low stock
+                  </Tag>
+                )
+              }
+            </AttentionTable.Column>
+          </AttentionTable>
+        )}
