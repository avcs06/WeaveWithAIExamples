+                  <Truncate>{title}</Truncate>
+                </NextLink>
+              )}
+            </AttentionTable.Column>
+            <AttentionTable.Column
+              id="glaze"
+              title="Glaze"
+              dataKey="glaze"
+              width={170}
+            />
+            <AttentionTable.Column
+              id="size"
+              title="Size"
+              dataKey="size"
+              width={110}
+            >
+              {(size) => sizeLabel(size)}
+            </AttentionTable.Column>
+            <AttentionTable.Column
+              id="stock"
+              title="Left"
+              dataKey="stock"
+              width={90}
+              align="right"
+            >
+              {(stock) => <Numeral>{stock}</Numeral>}
