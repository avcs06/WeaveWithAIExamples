{
  "brief": {
    "audience": "People in India buying small-batch handmade ceramics in occasional, unhurried visits, and the single Jaipur studio owner who manages pieces, stock, discount codes and orders.",
    "personality": [
      "earthy",
      "warm",
      "honest",
      "calm",
      "unhurried"
    ],
    "voice": "plain, warm, second person",
    "density": "spacious",
    "signature": "A warm off-white page framed in pale sand, with Fraunces headings and terracotta DM Mono figures for prices, stock and totals.",
    "feel": [
      "earthy",
      "minimal"
    ],
    "colorScheme": "light",
    "seedHue": 53,
    "seedChroma": "balanced",
    "frameHue": 53,
    "frameChroma": "balanced",
    "baseHue": 53,
    "baseChroma": "muted",
    "statusHues": {
      "success": 155,
      "warning": 84,
      "error": 32,
      "info": 246
    },
    "fonts": {
      "ui": [
        {
          "family": "Fira Sans",
          "reason": "A warm, highly legible humanist sans that feels friendly for buyers and remains clear for the owner's order and stock work."
        },
        {
          "family": "Lato",
          "reason": "Its warm, semi-rounded forms suit the studio's friendly personality and read comfortably at generous sizes."
        },
        {
          "family": "Nunito Sans",
          "reason": "A clean geometric sans near Avenir that would keep the shop feeling soft, modern and approachable."
        }
      ],
      "display": [
        {
          "family": "Fraunces",
          "reason": "Its soft, expressive old-style serif forms feel handmade, warm and crafted, suiting small-batch ceramics without becoming decorative or hard to read."
        },
        {
          "family": "DM Serif Display",
          "reason": "A refined transitional serif that would give headings a calm, gallery-like quality for the ceramics."
        },
        {
          "family": "Cormorant Garamond",
          "reason": "Its graceful literary forms suit an artisanal studio, though they are more delicate than Fraunces at shop heading sizes."
        }
      ],
      "mono": [
        {
          "family": "DM Mono",
          "reason": "Clean geometric figures line up clearly for prices, stock counts, order references and totals while staying warm and untechnical."
        },
        {
          "family": "IBM Plex Mono",
          "reason": "Its engineered, highly legible figures would work well for order references and stock counts, with a slightly more corporate feel."
        },
        {
          "family": "JetBrains Mono",
          "reason": "A clear monospace with a tall x-height that keeps figures and references easy to compare."
        }
      ]
    },
    "radius": "soft",
    "focusRing": "halo",
