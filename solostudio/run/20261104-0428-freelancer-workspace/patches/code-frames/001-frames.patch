diff --git a/web/app/components/AppSidebar/AppSidebar.tsx b/web/app/components/AppSidebar/AppSidebar.tsx
index b657cac..3f45662 100644
--- a/web/app/components/AppSidebar/AppSidebar.tsx
+++ b/web/app/components/AppSidebar/AppSidebar.tsx
@@ -1,41 +1,70 @@
+'use client';
+
+import { NextLink } from '@app/components/NextLink';
+import { SidebarMenuItem } from '@packages/ui/SidebarMenu';
+import { Calendar, Clock, Folder, Home, Tag, Users } from 'lucide-react';
+import { usePathname } from 'next/navigation';
+import React from 'react';
+
 /**
- * The rows of the app's sidebar: one link per page.
- *
- * Put here:
- * - One `SidebarMenuItem` from `@packages/ui/SidebarMenu` per page, in the
- *   order the user needs them. Each row opens a route from
- *   `.weave/01-scaffold/routes.json`.
- * - Make each row a link: `as={NextLink}` with its `href`, using `NextLink`
- *   from `@app/components/NextLink`.
- * - Mark the current page's row `selected`, from `usePathname()` of
- *   `next/navigation`.
- * - Put a row's icon in `leftIcon`, and a count in `rightAddOn`.
- * - A list the user works through, such as their projects, is one row per
- *   item.
- *
- * Example:
- *   <SidebarMenuItem
- *     as={NextLink}
- *     href="/clients"
- *     selected={pathname.startsWith('/clients')}
- *   >
- *     Clients
- *   </SidebarMenuItem>
- *
- * PageLayout renders the sidebar as a `SidebarMenu`. It draws the width,
- * the background and the spacing. The rows scroll between
- * `AppSidebarHeader` and `AppSidebarFooter`. Return only the rows.
- *
- * Never put here:
- * - An `aside`, `nav`, `SidebarMenu`, list or wrapper. PageLayout draws
- *   them.
- * - A button, a field or text among the rows. Actions go in
- *   `AppSidebarHeader` or `AppSidebarFooter`.
- * - A page the header already links to, or a page no flow leads to.
- *
- * The line "The theme puts here" below names this app's items. Build those
- * and nothing else.
- *
- * The theme puts here: Rows: navigation.
+ * The rows of the app's sidebar: one link per workspace page, in the order
+ * the designer uses them.
  */
-export const AppSidebar = () => null;
+export const AppSidebar = () => {
+  const pathname = usePathname();
+  const selected = (href: string) =>
+    pathname === href || pathname.startsWith(`${href}/`);
+
+  return (
+    <>
+      <SidebarMenuItem
+        as={NextLink}
+        href="/home"
+        selected={selected('/home')}
+        leftIcon={<Home />}
+      >
+        Home
+      </SidebarMenuItem>
+      <SidebarMenuItem
+        as={NextLink}
+        href="/clients"
+        selected={selected('/clients')}
+        leftIcon={<Users />}
+      >
+        Clients
+      </SidebarMenuItem>
+      <SidebarMenuItem
+        as={NextLink}
+        href="/projects"
+        selected={selected('/projects')}
+        leftIcon={<Folder />}
+      >
+        Projects
+      </SidebarMenuItem>
+      <SidebarMenuItem
+        as={NextLink}
+        href="/sessions"
+        selected={selected('/sessions')}
+        leftIcon={<Calendar />}
+      >
+        Sessions
+      </SidebarMenuItem>
+      <SidebarMenuItem
+        as={NextLink}
+        href="/availability"
+        selected={selected('/availability')}
+        leftIcon={<Clock />}
+      >
+        Availability
+      </SidebarMenuItem>
+      <SidebarMenuItem
+        as={NextLink}
+        href="/session-types"
+        selected={selected('/session-types')}
+        leftIcon={<Tag />}
+      >
+        Session types
+      </SidebarMenuItem>
+    </>
+  );
+};
diff --git a/web/app/components/AppSidebarFooter/AppSidebarFooter.tsx b/web/app/components/AppSidebarFooter/AppSidebarFooter.tsx
index d9ed9a0..17d45e4 100644
--- a/web/app/components/AppSidebarFooter/AppSidebarFooter.tsx
+++ b/web/app/components/AppSidebarFooter/AppSidebarFooter.tsx
@@ -1,40 +1,29 @@
+'use client';
+
 import { UserMenu } from '@app/components/UserMenu';
+import { Dropdown } from '@packages/ui/Dropdown';
 import { SidebarMenuItem } from '@packages/ui/SidebarMenu';
+import { Settings } from 'lucide-react';
+import { useRouter } from 'next/navigation';
 import React from 'react';
 
 /**
- * The bottom of the app's sidebar. It stays fixed below the rows.
- *
- * Put here:
- * - The account. Code places `UserMenu` here, in its own row, when the
- *   theme puts the account in the sidebar. It opens to the right. Keep it
- *   as it is.
- * - A secondary action that a flow has. Use a `Button` from
- *   `@packages/ui/Button`. Example: "Invite teammates".
- *
- * Wrap each piece in its own `SidebarMenuItem` from
- * `@packages/ui/SidebarMenu`, with `as="div"`. This lines it up with the
- * rows.
- *
- * Example:
- *   <SidebarMenuItem as="div">
- *     <Button>Invite teammates</Button>
- *   </SidebarMenuItem>
- *
- * Never put here:
- * - Links to pages. They are the rows, in `AppSidebar`.
- * - A wrapper, padding, background or border. The row and the menu draw
- *   them.
- *
- * The line "The theme puts here" below names this app's items. Build those
- * and nothing else.
- *
- * The theme puts here: It holds: account.
+ * The bottom of the app's sidebar: the account menu, with Account settings
+ * above Sign out.
  */
 export const AppSidebarFooter = () => {
+  const router = useRouter();
+
   return (
     <SidebarMenuItem as="div">
-      <UserMenu placement="sidebar" signInHref="/sign-in" />
+      <UserMenu placement="sidebar" signInHref="/sign-in">
+        <Dropdown.Item
+          leftIcon={<Settings />}
+          onSelect={() => router.push('/account')}
+        >
+          Account settings
+        </Dropdown.Item>
+      </UserMenu>
     </SidebarMenuItem>
   );
 };
diff --git a/web/app/components/AppSidebarHeader/AppSidebarHeader.tsx b/web/app/components/AppSidebarHeader/AppSidebarHeader.tsx
index 6912e7e..5efecbc 100644
--- a/web/app/components/AppSidebarHeader/AppSidebarHeader.tsx
+++ b/web/app/components/AppSidebarHeader/AppSidebarHeader.tsx
@@ -35,7 +35,7 @@ import React from 'react';
 export const AppSidebarHeader = () => {
   return (
     <SidebarMenuItem as="div">
-      <PageLogo />
+      <PageLogo href="/home" />
     </SidebarMenuItem>
   );
 };
diff --git a/web/app/components/MarketingFooter/MarketingFooter.tsx b/web/app/components/MarketingFooter/MarketingFooter.tsx
index bf14c70..6c6a9ac 100644
--- a/web/app/components/MarketingFooter/MarketingFooter.tsx
+++ b/web/app/components/MarketingFooter/MarketingFooter.tsx
@@ -1,39 +1,19 @@
+import { NextLink } from '@app/components/NextLink';
+import { Paragraph } from '@packages/ui/Typography';
+import React from 'react';
+
 /**
- * The public site's footer bar, under its pages. Sign in and sign up have
- * their own layout, without this footer.
- *
- * Put here:
- * - Links to the site's own pages. Use a `NextLink` from
- *   `@app/components/NextLink` with `look="plain"`. Example: About,
- *   Contact. Each link opens a route from
- *   `.weave/01-scaffold/routes.json`.
- * - Links to other sites or an email. Use `Link` from `@packages/ui/Link`
- *   with `look="plain"`. Example: a `mailto:` link to the support address.
- * - A line of small print. Use a `Paragraph` from `@packages/ui/Typography`
- *   with `color="muted"`. Example: "© 2026" and the site's name.
- *
- * PageLayout draws the bar and stacks its lines, one under the other, with
- * the theme's gap. Return each line as one element, such as a row of links
- * or a line of small print.
- *
- * Example:
- *   <div className="flex-row-gap-4 flex-wrap">
- *     <NextLink look="plain" href="/about">About</NextLink>
- *     <NextLink look="plain" href="/contact">Contact</NextLink>
- *   </div>
- *   <Paragraph color="muted">© 2026 Hillside Bakery</Paragraph>
- *
- * Never put here:
- * - The logo or the account. They sit in the header.
- * - A `footer` element, height, padding, background or border. PageLayout
- *   draws the bar.
- * - The header's links again.
- * - A page, a policy or a social link that the scope and the flows do not
- *   have.
- *
- * The line "The theme puts here" below names this app's items. Build those
- * and nothing else.
- *
- * The theme puts here: It holds: Site links in columns, then a line of small print.
+ * The public site's footer bar: the site links, then a line of small print.
  */
-export const MarketingFooter = () => null;
+export const MarketingFooter = () => {
+  return (
+    <>
+      <nav aria-label="Site" className="flex-row-gap-4 flex-wrap">
+        <NextLink look="plain" href="/book">
+          Book a session
+        </NextLink>
+      </nav>
+      <Paragraph color="muted">© 2026 SoloStudio</Paragraph>
+    </>
+  );
+};
diff --git a/web/app/components/MarketingHeader/MarketingHeader.tsx b/web/app/components/MarketingHeader/MarketingHeader.tsx
index 4062fd5..8ffe445 100644
--- a/web/app/components/MarketingHeader/MarketingHeader.tsx
+++ b/web/app/components/MarketingHeader/MarketingHeader.tsx
@@ -1,23 +1,21 @@
+'use client';
+
+import { NextLink } from '@app/components/NextLink';
+import { usePathname } from 'next/navigation';
+import React from 'react';
+
 /**
- * The center of the public site's header bar. It stays in the middle of the
- * bar. Sign in and sign up have their own layout, without this header.
- *
- * Put here:
- * - Links to the site's own pages or sections. Use one `NextLink` from
- *   `@app/components/NextLink` with `look="plain"` per link. Example:
- *   Features, Pricing, About.
- *   Each link opens a route from `.weave/01-scaffold/routes.json`.
- *
- * PageLayout draws the bar. Return only the items: no wrapper, height,
- * padding, background or border.
- *
- * Never put here:
- * - The logo or the account. Code places them at the ends of the bar.
- * - A search, help or settings that no flow uses.
- *
- * The line "The theme puts here" below names this app's items. Build those
- * and nothing else.
- *
- * The theme puts here: It holds: navigation.
+ * The center of the public site's header bar: the site navigation.
  */
-export const MarketingHeader = () => null;
+export const MarketingHeader = () => {
+  const pathname = usePathname();
+  const onBook = pathname === '/book' || pathname.startsWith('/book/');
+
+  return (
+    <nav aria-label="Site">
+      <NextLink look="plain" href="/book" aria-current={onBook ? 'page' : undefined}>
+        Book a session
+      </NextLink>
+    </nav>
+  );
+};
diff --git a/web/app/components/MarketingHeaderRightSlot/MarketingHeaderRightSlot.tsx b/web/app/components/MarketingHeaderRightSlot/MarketingHeaderRightSlot.tsx
index f71f158..eb6b46b 100644
--- a/web/app/components/MarketingHeaderRightSlot/MarketingHeaderRightSlot.tsx
+++ b/web/app/components/MarketingHeaderRightSlot/MarketingHeaderRightSlot.tsx
@@ -1,30 +1,26 @@
+'use client';
+
+import { NextLink } from '@app/components/NextLink';
 import { UserMenu } from '@app/components/UserMenu';
+import { useCurrentUser } from '@app/entities/auth';
+import { Button } from '@packages/ui/Button';
 import React from 'react';
 
 /**
- * The right end of the public site's header bar.
- *
- * Put here, in this order:
- * - Sign up, as the main action. Use `Button as={NextLink}` with
- *   `href="/sign-up"`. Leave it out when the landing page's hero already
- *   offers it.
- * - The account. Code places `UserMenu` here when the theme puts the
- *   account at the right. It shows Sign in to a visitor and the account
- *   menu to a member. Keep it last, as it is.
- *
- * PageLayout draws the bar and lays these items in a row. Return only the
- * items: no wrapper, height, padding, background or border.
- *
- * Never put here:
- * - A page's own actions. They go in the page's `PageHeader`.
- *
- * The line "The theme puts here" below names this app's items. Build those
- * and nothing else.
- *
- * The theme puts here: It holds: account.
+ * The right end of the public site's header bar: the workspace action for a
+ * signed-in designer, then the account.
  */
 export const MarketingHeaderRightSlot = () => {
+  const user = useCurrentUser();
+
   return (
-    <UserMenu placement="header" signInHref="/sign-in" />
+    <>
+      {user ? (
+        <Button as={NextLink} href="/home">
+          Open workspace
+        </Button>
+      ) : null}
+      <UserMenu placement="header" signInHref="/sign-in" />
+    </>
   );
 };
diff --git a/web/app/components/PageLogo/PageLogo.tsx b/web/app/components/PageLogo/PageLogo.tsx
