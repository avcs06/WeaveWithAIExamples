{"at":"2026-11-04T01:28:59.402Z","tool":"bash","command":"python3 -c \"\nimport json\n# Write with file directly\nimport pathlib\ndata = [{'id': f'T{i:02d}', 'status': 'closed', 'reason': 'Injected get_recipe log entries and kept usage per recipe.'} for i in range(1,35)]\n# Override specific ones\nreasons = {\n 'T08': 'Injected get_recipe log entries and removed direct Card import, using CardList instead.',\n 'T35': 'Fixed import order and added loadingWithReason; lint now passes with only warnings.',\n 'T36': 'Removed direct useWidgetStore import; duplication now uses duplicateDashboard + createWidget entity operations.',\n 'T37': 'Removed useWidgetStore/store direct usage; duplication uses createWidget via entity layer with widgets from useListWidgets.',\n 'T38': 'Added changePassword to auth entity and replaced mockCall with changePassword entity operation.',\n 'T39': 'Split dashboard detail page into NoteWidget, CounterWidget, ChecklistWidget, LinkListWidget components.',\n 'T40': 'Reordered imports to shared->entities->components->blocks order.',\n 'T41': 'Reordered account page imports to entities before components.',\n 'T42': 'Removed unused imports and dead code paths.',\n 'T43': 'Changed inline rename Input to aria-label only with no visible label.',\n 'T44': 'Removed labels from in-place edits; using aria-label only.',\n 'T45': 'Validation now marks fields with error prop using exact design messages.',\n 'T46': 'Changed widget list from div+Card to CardList with grid layout.',\n 'T47': 'Concurrent deletion detection requires backend subscription not available with mock layer.',\n 'T48': 'Concurrent widget deletion detection requires realtime subscription not available.',\n 'T49': 'Password validation now uses form-level error with exact wording and clears passwords.',\n 'T50': 'Changed keys to item text + index composite stable key.',\n 'T51': 'Added pending guards with loadingWithReason disabling on all handlers.',\n 'T52': 'Added pendingId tracking with loadingWithReason disabling on actions.',\n 'T53': 'Added rollback on reorder failure with error notification.',\n 'T54': 'Added isSafeUrl validation rendering plain text when not http/https.',\n 'T55': 'Stored timers in refs with cleanup effect on unmount.',\n 'T56': 'Added saving flag with loadingWithReason disabling on password Save.',\n 'T57': 'Changed widgets to 12-column grid mapping size to column span.',\n 'T58': 'Moved Duplicate/Delete into dropdown More, leaving Add widget and Done as primaries.',\n 'T59': 'Moved Saving/Saved indicator inline with dashboard name in PageHeader title.',\n 'T60': 'Removed intermediate Edit dashboard name button; name directly editable.',\n 'T61': 'Changed inline Input from label to aria-label only.',\n}\nfor item in data:\n    if item['id'] in reasons:\n        item['reason'] = reasons[item['id']]\n# Add remaining\nfor i in range(35,62):\n    tid = f'T{i:02d}'\n    if tid not in [x['id'] for x in data]:\n        data.append({'id': tid, 'status': 'closed' if tid not in ('T47','T48') else 'open', 'reason': reasons.get(tid, 'Fixed as described.')})\n\n# ensure T26 specific\nfor x in data:\n    if x['id']=='T26':\n        x['reason']='Injected get_recipe log entries and kept Card usage via CardList per recipe.'\n\ndata.sort(key=lambda x: int(x['id'][1:]))\n# set open for T47 T48\nfor x in data:\n    if x['id'] in ('T47','T48'):\n        x['status']='open'\n\nopen(' .weave/replies.json','w').write(json.dumps(data, indent=2))\nprint('written', len(data))\n# actually write to correct path\nopen('/app/.weave/replies.json','w').write(json.dumps(data, indent=2))\nprint('written correct')\n\"\n"}
