--- a/web/app/components/AppHeaderRightSlot/AppHeaderRightSlot.tsx
+++ b/web/app/components/AppHeaderRightSlot/AppHeaderRightSlot.tsx
@@ -1,3 +1,13 @@
+'use client';
+
+import { useCurrentUser } from '@app/entities/auth';
+import { createDashboard } from '@app/entities/dashboard';
+import { useDashboardStore } from '@app/entities/dashboard/store';
+import { Button } from '@packages/ui/Button';
+import { Plus } from 'lucide-react';
+import { useRouter } from 'next/navigation';
+import React, { useState } from 'react';
+
 /**
  * The right end of the app's header bar.
  *
@@ -19,4 +29,36 @@
  *
  * The theme puts here: It holds: Create button.
  */
-export const AppHeaderRightSlot = () => null;
+export const AppHeaderRightSlot = () => {
+  const user = useCurrentUser();
+  const router = useRouter();
+  const [creating, setCreating] = useState(false);
+
+  if (user === undefined || user === null) return null;
+
+  const handleCreate = async () => {
+    if (creating) return;
+    setCreating(true);
+    try {
+      const records = useDashboardStore.getState().records;
+      const base = 'Untitled Dashboard';
+      let name = base;
+      let n = 2;
+      const names = new Set(records.map((r) => r.name));
+      while (names.has(name)) {
+        name = `${base} ${n}`;
+        n += 1;
+      }
+      const dashboard = await createDashboard({ name, lastEditedAt: new Date().toISOString() });
+      router.push(`/dashboards/${dashboard.id}`);
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  return (
+    <Button leftIcon={<Plus />} loading={creating} onClick={handleCreate}>
+      Create dashboard
+    </Button>
+  );
+};
