  *
@@ -38,4 +47,28 @@
  *
  * The theme puts here: Rows: navigation.
  */
-export const AppSidebar = () => null;
+export const AppSidebar = () => {
+  const user = useCurrentUser();
+  const pathname = usePathname();
+
+  if (user === undefined) return null;
+
+  if (user === null) {
+    return (
+      <SidebarMenuItem as={NextLink} href="/sign-in">
+        Sign in to continue
+      </SidebarMenuItem>
+    );
+  }
+
+  return (
+    <>
+      <SidebarMenuItem as={NextLink} href="/dashboards" selected={pathname.startsWith('/dashboards')} leftIcon={<LayoutDashboard />}>
+        Dashboards
+      </SidebarMenuItem>
+      <SidebarMenuItem as={NextLink} href="/account" selected={pathname.startsWith('/account')} leftIcon={<User />}>
+        Account
+      </SidebarMenuItem>
+    </>
+  );
+};
